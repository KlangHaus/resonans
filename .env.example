# Resonans — copy to .env and fill in. `docker compose up -d` reads this file.
#
# Generate each secret with:  openssl rand -base64 32
# Nothing here has a default: a CMS that boots with a blank password is worse
# than one that refuses to boot.

# ── Required ────────────────────────────────────────────────────────────────
# Postgres. Two roles on purpose: the migrator owns the schema, the server
# connects as a role that CANNOT bypass row level security. Tenant isolation
# rests on that, so do not collapse them into one. See deploy/initdb/.
POSTGRES_PASSWORD=
RESONANS_APP_PASSWORD=

# Authenticates the trusted server-to-server read surface (/delivery), used by
# your own front-ends. Unset in production the server refuses to start, because
# it would otherwise trust an unauthenticated tenant header — a cross-tenant
# read hole.
RESONANS_DELIVERY_TOKEN=

# ── Editor login (required) ─────────────────────────────────────────────────
# Resonans does not manage users. It verifies a JWT from an OIDC-style issuer
# against that issuer's published JWKS, and reads the tenant from the `org`
# claim. Point these at your identity provider — anything that issues JWTs and
# serves a JWKS document works; we run BetterAuth.
#
# Both must be set or the server refuses to start. That is deliberate: an
# earlier version inferred "development" from an empty variable, so one missing
# value opened the editor API to an unauthenticated header.
RESONANS_JWT_ISSUER=https://auth.example.org
RESONANS_JWKS_URL=https://auth.example.org/.well-known/jwks.json
# Same issuer, as the browser reaches it. Empty = no login in the editor at all.
RESONANS_AUTH_BASE=https://auth.example.org

# ── Addresses ───────────────────────────────────────────────────────────────
# The API's externally reachable base URL. Asset URLs are built from it, so a
# wrong value here surfaces as broken images rather than as an error.
PUBLIC_URL=http://localhost:3000
API_PORT=3000
STUDIO_PORT=8080
# Pin a release instead of tracking `latest` in anything you care about.
RESONANS_VERSION=latest

# ── Optional ────────────────────────────────────────────────────────────────
# HMAC secret signing short-lived draft-preview tokens. Empty = preview off.
RESONANS_PREVIEW_SECRET=

# AGPL-3.0 §13: if you MODIFY Resonans and offer it to users over a network,
# you owe those users your source. Point this at your repository and /healthz
# will say so. Empty = upstream, which is only true if you changed nothing.
RESONANS_SOURCE_URL=

# Asset bytes. compose.yml uses a local volume (RESONANS_STORAGE_DIR) and
# Resonans serves them at /_assets itself. To put a CDN in front instead, set
# all three BUNNY_* values; they win over the local volume. Leave BUNNY_CDN_BASE
# empty unless you use Bunny — empty follows PUBLIC_URL.
BUNNY_STORAGE_ENDPOINT=
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_KEY=
BUNNY_CDN_BASE=

# Optional video plugin. "vimeo" enables Vimeo embeds via public oEmbed (no
# token). Empty = disabled.
RESONANS_VIDEO_PROVIDER=

# OpenTelemetry. Empty endpoint = no-op. tenant.id is set per request on spans,
# never on the resource, so traces cannot leak a tenant list.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=resonans
OTEL_EXPORTER_OTLP_ENDPOINT=
