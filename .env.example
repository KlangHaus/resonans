# Resonans — copy to .env and fill in. `docker compose up -d` reads this file.
#
# Generate each secret with:  openssl rand -base64 32
# Nothing here has a default: a CMS that boots with a blank password is worse
# than one that refuses to boot.

# ── Required ────────────────────────────────────────────────────────────────
# Postgres. Two roles on purpose: the migrator owns the schema, the server
# connects as a role that CANNOT bypass row level security. Tenant isolation
# rests on that, so do not collapse them into one. See deploy/initdb/.
POSTGRES_PASSWORD=
RESONANS_APP_PASSWORD=

# Authenticates the trusted server-to-server read surface (/delivery), used by
# your own front-ends. Unset in production the server refuses to start, because
# it would otherwise trust an unauthenticated tenant header — a cross-tenant
# read hole.
RESONANS_DELIVERY_TOKEN=

# ── Editor login (required) ─────────────────────────────────────────────────
# Resonans does not manage users (ADR 0001, docs/adr/). Editors log in with
# standard OpenID Connect at any provider you already run — Keycloak, Authentik,
# Zitadel, Authelia, BetterAuth's OIDC provider; we run the last one. Register
# Resonans' editor there as a CONFIDENTIAL client (authorization code + PKCE)
# with the redirect URI <EDITOR_URL>/auth/callback.
#
# The API verifies the provider's access tokens. Issuer, JWKS and audience must
# all be set or the server refuses to start: an earlier version inferred
# "development" from an empty variable, so one missing value opened the editor
# API to an unauthenticated header; and without an audience it would accept a
# token the provider minted for any other service.
RESONANS_JWT_ISSUER=https://auth.example.org
RESONANS_JWKS_URL=https://auth.example.org/.well-known/jwks.json
# The `aud` the provider puts in access tokens for Resonans.
RESONANS_JWT_AUDIENCE=resonans

# Where tenant and role come from. Every editor needs a role, or every request
# is refused with 403 — there is no default role, on purpose:
#   viewer     read everything
#   editor     + create and edit drafts, upload assets, preview
#   publisher  + publish, delete, restore, roll back
#   admin      + tenant settings
# The role claim may be a string or an array (groups); the highest role wins.
# RESONANS_ROLE_MAP maps values your provider already issues to those roles,
# e.g. `cms-admins=admin,cms-writers=editor`. Unknown names are refused at boot.
RESONANS_ROLE_CLAIM=resonans_role
RESONANS_ROLE_MAP=
# One organisation? Use single-tenant mode and the tenant claim is not read at
# all — your provider only has to issue a role. Generate an id with `uuidgen`.
RESONANS_TENANT_MODE=single
RESONANS_TENANT_ID=
# Multi-tenant (RESONANS_TENANT_MODE=multi) reads the tenant from this claim.
RESONANS_TENANT_CLAIM=org

# The editor's side of the login. Its server is the OIDC client: it keeps the
# tokens and gives the browser only a sealed HttpOnly cookie.
EDITOR_URL=http://localhost:8080
OIDC_CLIENT_ID=resonans-editor
OIDC_CLIENT_SECRET=
# Seals the editor's session cookie. openssl rand -base64 32
EDITOR_SESSION_SECRET=

# In production both of the two above must be https, or the server refuses to
# start. The JWKS is the TRUST ANCHOR for every editor request: fetched over
# plain http, anyone on the path can substitute the signing keys and mint tokens
# this server would accept. That is an authentication bypass, not a warning.
#
# If you legitimately reach your identity provider over http on a private network
# — a service name inside a compose network, say — waive it on purpose. It is a
# variable rather than an inferred exception because the thing being given up is
# the integrity of the trust anchor, and every boot then logs the URL it fetched
# insecurely. Only the exact value 1 waives it; "true" and "yes" do not.
RESONANS_ALLOW_INSECURE_JWKS=

# ── Addresses ───────────────────────────────────────────────────────────────
# The API's externally reachable base URL. Asset URLs are built from it, so a
# wrong value here surfaces as broken images rather than as an error.
PUBLIC_URL=http://localhost:3000
API_PORT=3000
STUDIO_PORT=8080
# Pin a release instead of tracking `latest` in anything you care about.
RESONANS_VERSION=latest

# ── Optional ────────────────────────────────────────────────────────────────
# HMAC secret signing short-lived draft-preview tokens. Empty = preview off.
RESONANS_PREVIEW_SECRET=

# AGPL-3.0 §13: if you MODIFY Resonans and offer it to users over a network,
# you owe those users your source. Point this at your repository and /healthz
# will say so. Empty = upstream, which is only true if you changed nothing.
RESONANS_SOURCE_URL=

# Asset bytes. compose.yml uses a local volume (RESONANS_STORAGE_DIR) and
# Resonans serves them at /_assets itself. To put a CDN in front instead, set
# all three BUNNY_* values; they win over the local volume. Leave BUNNY_CDN_BASE
# empty unless you use Bunny — empty follows PUBLIC_URL.
BUNNY_STORAGE_ENDPOINT=
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_KEY=
BUNNY_CDN_BASE=

# Optional video plugin. "vimeo" enables Vimeo embeds via public oEmbed (no
# token). Empty = disabled.
RESONANS_VIDEO_PROVIDER=

# OpenTelemetry. Empty endpoint = no-op. tenant.id is set per request on spans,
# never on the resource, so traces cannot leak a tenant list.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=resonans
OTEL_EXPORTER_OTLP_ENDPOINT=
