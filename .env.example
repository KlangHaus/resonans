# Resonans CMS — dev/local example. Production secrets bor i SOPS+age
# (provisioneres af [infra] som env i compose; se infra/RUNBOOK.md).

NODE_ENV=development
HOST=0.0.0.0
# Deploy-kontrakt: Caddy reverse-proxyer til resonans:3000 (vm2-ops Caddyfile).
PORT=3000
LOG_LEVEL=debug

# Canonical extern base-URL. Deploy-kontrakt: PUBLIC_URL.
PUBLIC_URL=http://localhost:3000

# Egen content-DB (Beslutning K — self-host, adskilt fra Etudes money-tier-DB).
# Deploy-kontrakt: DATABASE_URL. Tom = in-memory content-store (dev/test only).
# App'en forbinder som en NON-BYPASSRLS-rolle; migrations køres som BYPASSRLS.
# Migrations køres ved boot.
DATABASE_URL=

# Redaktør-login: BetterAuth-JWT verificeret lokalt mod cached JWKS; tenant =
# `org`-claim (Beslutning D + K). Begge sat = auth aktiv. I prod SKAL de være
# sat (ellers boot-fejl). Tom i dev = auth deaktiveret; tenant sættes da via
# `X-Dev-Tenant`-header (KUN dev/test).
RESONANS_JWT_ISSUER=
RESONANS_JWKS_URL=

# Delivery (read/leverings-API til server-side Nuxt-forbrugere: Etude-Nitro +
# klanghaus.dk). Betroet service-til-service: kalder autentificerer med denne
# token, tenant sendes via X-Scope-OrgID (kun trusted når token matcher). Sat =
# /delivery kræver token. I prod SKAL den være sat (ellers boot-fejl = åben
# cross-tenant-read). Tom i dev = X-Scope-OrgID trustes direkte (KUN dev/test).
RESONANS_DELIVERY_TOKEN=

# Preview (Fase 5): HMAC-secret der signerer kortlivede preview-tokens (editor
# draft-preview). Tom = preview-endpoints deaktiveret. Sæt i prod via SOPS.
RESONANS_PREVIEW_SECRET=

# Media / object storage (Fase 3). Bunny Storage holder asset-bytes; CDN-base =
# pull-zone-URL til at bygge offentlige asset-URLs. Tom storage-config = in-memory
# backend (dev/test only, ikke-persistent). Sættes af [infra] via SOPS i prod.
BUNNY_STORAGE_ENDPOINT=
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_KEY=
BUNNY_CDN_BASE=http://localhost:3000/_assets
# Video-plugin (tilvælgeligt): "vimeo" aktiverer Vimeo embed-URL-provider. Tom = deaktiveret.
RESONANS_VIDEO_PROVIDER=

# OTel — fra dag ét (product brief). Tom endpoint = no-op (dev/test).
# tenant.id sættes pr. request på spans, ikke på resource.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=klanghaus-resonans
OTEL_SERVICE_NAMESPACE=klanghaus
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
