# Resonans CMS — dev/local example. Production secrets bor i SOPS+age
# (provisioneres af [infra] som env i compose; se infra/RUNBOOK.md).

NODE_ENV=development
HOST=0.0.0.0
# Deploy-kontrakt: Caddy reverse-proxyer til resonans:3000 (vm2-ops Caddyfile).
PORT=3000
LOG_LEVEL=debug

# Canonical extern base-URL. Deploy-kontrakt: PUBLIC_URL (compose sætter
# https://indhold.klanghaus.dk i prod).
PUBLIC_URL=http://localhost:3000

# Content-scope. Beslutning B: single-site nu (klanghaus.dk); multi-site + RLS
# senere uden migrations-rewrite (entries.site findes fra dag ét).
RESONANS_DEFAULT_SITE=klanghaus.dk

# Postgres (Beslutning K — self-host). Deploy-kontrakt: DATABASE_URL. Tom =
# in-memory content-store (dev/test only). Migrations køres ved boot.
DATABASE_URL=

# Editor write-gate (placeholder). Shared-secret bearer indtil BetterAuth-JWT +
# PDP editor-login lander (follow-up issue). Tom i dev = writes UGUARDEDE;
# tom i prod = boot fejler (fail-closed).
EDITOR_API_TOKEN=

# OTel — fra dag ét (product brief). Tom endpoint = no-op (dev/test).
# site/tenant.id sættes pr. request på spans, ikke på resource.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=klanghaus-resonans
OTEL_SERVICE_NAMESPACE=klanghaus
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
